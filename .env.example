# ==============================================================
# Autonomous AI Data Analyst - Environment Configuration
# ==============================================================

# LLM / AI Configuration (Google Gemini)
# Free API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini

# Database Configuration (Defaults to zero-config local SQLite)
# For Docker Compose: postgresql+asyncpg://analyst:analyst_secret_password@postgres:5432/analyst_db
DATABASE_URL=sqlite+aiosqlite:///./data/analyst.db

# Security & Limits
MAX_UPLOAD_SIZE_BYTES=104857600
QUERY_TIMEOUT_SECONDS=30
MAX_RESULT_ROWS=1000

# Langfuse Observability (Optional)
ENABLE_OBSERVABILITY=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
